# Slip reader agent config — copy this file to `.env` (same folder) and edit.
# Real environment variables (if set) take precedence over this file.

# Base URL of the POS API worker (no trailing slash).
SLIP_API_BASE=http://127.0.0.1:8787
# SLIP_API_BASE=https://pos.twostackmaxgame.win

# Shared secret — must match the worker secret SLIP_AGENT_TOKEN exactly.
SLIP_AGENT_TOKEN=change-me

# Local Ollama server (defaults shown).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b
